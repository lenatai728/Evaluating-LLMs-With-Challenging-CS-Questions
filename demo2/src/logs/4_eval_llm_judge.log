```python
import heapq

# Example demonstrating a priority queue where elements are dequeued based on priority, not insertion order.
pq = []
# Insert elements with (priority, value) pairs. Lower priority number means higher priority.
heapq.heappush(pq, (3, 'Task C'))
heapq.heappush(pq, (1, 'Task A'))  # Higher priority (1)
heapq.heappush(pq, (2, 'Task B'))
heapq.heappush(pq, (0, 'Task High'))  # Highest priority (0)

# Dequeue elements
while pq:
    priority, task = heapq.heappop(pq)
    print(f'Dequeued: {task} with priority {priority}')
# Output shows tasks dequeued in order of increasing priority (0,1,2,3), regardless of insertion order.
```
